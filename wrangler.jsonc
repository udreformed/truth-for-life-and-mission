{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tflm",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "truth-for-life-and-mission",
			"database_id": "fb0613ba-1e0c-43a4-b7f4-b7323b311520",
			"migrations_dir": "./database/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "d20d81bad5954d308ed8941b94578f5f"
		}
	],
	// Enable this binding after R2 is activated in the Cloudflare account.
	// "r2_buckets": [
	//   {
	//     "binding": "MEDIA",
	//     "bucket_name": "truth-for-life-and-mission-media"
	//   }
	// ],
	"vars": {
		"AI_ENABLED": "true",
		"AI_DAILY_LIMIT": "20",
    "SITE_URL": "https://tflm.pages.dev",
		"ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
		"ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
	},
	"observability": {
		"enabled": true
	}
}
