---
import type { ResourceSummary } from "../lib/resources";
import type { Language } from "../lib/i18n";
import { copy, typeLabels } from "../lib/i18n";
import ShareButtons from "./ShareButtons.astro";

interface Props {
  resource: ResourceSummary;
  lang: Language;
}

const { resource, lang } = Astro.props;
const t = copy[lang];
const href = resource.external_url ?? `/${lang}/library/${resource.slug}/`;
const isExternal = Boolean(resource.external_url);
const actionLabel = resource.external_label ?? t.read;
const bodyPreviewSlugs = new Set(["reformation-five-pillars", "limited-atonement-evangelism", "five-ways-prosperity-gospel"]);
const shouldShowBodyPreview = resource.type === "article" && lang !== "en" && bodyPreviewSlugs.has(resource.slug) && Boolean(resource.body);
const bodyPreview = shouldShowBodyPreview
  ? `${(resource.body ?? "").replace(/\s+/g, " ").trim().slice(0, lang === "th" ? 260 : 210)}…`
  : resource.summary;
const showTranslationNotice = Boolean(resource.translation_notice) && !(lang === "en" && resource.type === "devotional");
---

<article class="resource-card">
  <div class="resource-card-top">
    <span class="type-pill">{typeLabels[lang][resource.type] ?? resource.type}</span>
    {resource.youtube_url && <span class="media-hint">YouTube</span>}
    {showTranslationNotice && <span class="machine-translation-note">{resource.translation_notice}</span>}
  </div>
  <h3>
    <a href={href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>{resource.title}</a>
  </h3>
  <p>{bodyPreview}</p>
  <a class="text-link" href={href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>{actionLabel} <span aria-hidden="true">{isExternal ? "↗" : "→"}</span></a>
  {resource.type !== "article" && <ShareButtons lang={lang} url={href} title={resource.title} />}
</article>
